# Local PostgreSQL (safe development defaults)
POSTGRES_DB=techadvisor
POSTGRES_USER=techadvisor
POSTGRES_PASSWORD=devpassword
DB_HOST=localhost
DB_PORT=5433

# Future application secrets - leave real values out of Git
AI_API_KEY=
JWT_SECRET=

# MobileAPI.dev scraper (local testing only; never commit the real key)
MOBILEAPI_API_KEY=
# Optional: leave blank to fetch the default device list, or set a year such as 2024.
MOBILEAPI_YEAR=

# Ingestion is opt-in until real adapters/sinks and admin authentication are integrated.
INGESTION_SCHEDULING_ENABLED=false
INGESTION_ANCHOR=2026-09-17T05:00:00Z
INGESTION_ENABLED_SOURCES=
# Local demo only: set a password of at least 12 characters in your shell.
# INGESTION_DEMO_PASSWORD=
