# =============================================================================
# Single source of truth for every secret and cross-service setting.
#
# Copy to `.env` and fill in the blanks. Every service reads THIS file:
#   backend   - Spring Boot, via application.properties placeholders
#   ai        - pydantic-settings, resolved from the repo root (any working dir)
#   frontend  - Vite, via `envDir: '..'` in vite.config.ts
#   compose   - docker-compose.yml, via `env_file`
#
# Non-secret service tuning stays in code. The AI layer's knobs (K, LLM_MODEL,
# LLM_EFFORT, CHUNK_CHAR_CAP, ...) are typed defaults in ai/app/config.py and
# can be overridden here or in your shell when you actually need to change one.
#
# Never commit real secrets. `.env` is git-ignored; this example file is not.
# =============================================================================

# --- Database (backend, compose) ---------------------------------------------
POSTGRES_DB=techadvisor
POSTGRES_USER=techadvisor
POSTGRES_PASSWORD=devpassword
DB_HOST=localhost
DB_PORT=5434

# --- AI layer ----------------------------------------------------------------
# Which vendor answers: anthropic | openrouter | openai | custom.
# Everything except `anthropic` goes through one OpenAI-compatible adapter,
# so adding a vendor is a base URL, not new code.
LLM_PROVIDER=anthropic

# The model id travels WITH the provider, which is why it lives here and not
# with the tuning defaults in ai/app/config.py: one model is named differently
# per vendor (claude-opus-5 natively vs anthropic/claude-opus-5 on OpenRouter),
# so changing one without the other is always a mistake.
LLM_MODEL=claude-opus-5

# Only the credential matching LLM_PROVIDER is read; the others can stay blank.
# Blank is a valid local state: the test suite, /health and /docs all still
# work. POST /assess is the only thing that needs one, and it fails loudly.
# For anthropic there is also `ant auth login` instead of a key here.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# LLM_PROVIDER=custom only - anything else speaking the OpenAI wire format.
# Ollama: http://localhost:11434/v1   vLLM, Groq, Together, a company gateway.
LLM_BASE_URL=
LLM_API_KEY=

# Shared secret Spring Boot must send as `Authorization: Bearer <token>`.
# BLANK DISABLES AUTHENTICATION on /assess entirely - local development only.
AI_SERVICE_TOKEN=

# Host port the ai container publishes on.
AI_PORT=8000

# Where Spring Boot reaches the AI service for POST /assess. Run from the host
# (mvnw spring-boot:run) that is localhost:AI_PORT; a containerised backend on
# the compose network would use http://ai:8000 instead.
AI_SERVICE_URL=http://localhost:8000

# Retrieval backend: "local" reads ai/data/vector_store/*.json, "pgvector"
# reads review_chunks (needs migrations V4+V5 and the pgvector image).
VECTOR_STORE=local
# Must match whatever embedded the stored chunks. Nothing can detect a
# mismatch at runtime except the embedder column check - it just returns
# confident nonsense. Re-run scripts/ingest.py after changing this.
EMBEDDER=model2vec

# --- Frontend (Vite; VITE_-prefixed vars are exposed to the browser) ---------
# Read from THIS file via `envDir: '..'`. A frontend/.env will NOT be read.
VITE_API_BASE_URL=http://localhost:8080
VITE_INGESTION_DEMO=false

# --- Ingestion (backend) -----------------------------------------------------
# Opt-in until real adapters/sinks and admin authentication are integrated.
INGESTION_SCHEDULING_ENABLED=false
INGESTION_ANCHOR=2026-09-17T05:00:00Z
INGESTION_ENABLED_SOURCES=
# Local demo only: set a password of at least 12 characters in your shell.
# INGESTION_DEMO_PASSWORD=

# --- Backend JWT authentication ----------------------------------------------
# Required whenever the Spring Boot backend starts. Generate a local-only
# Base64 value that decodes to at least 32 random bytes; never commit the value.
JWT_SECRET=
# Optional lifetime override; must be greater than zero.
JWT_EXPIRATION_SECONDS=3600

# --- Deterministic upgrade classification (AGENTS.md §7.1, §18.9) -----------
# upgrade-score is 0-1: 1.0 is a strong upgrade recommendation, 0.0 is not
# recommended. The defaults live ONLY in backend/src/main/resources/
# application.properties (recommendation.scoring.*), which is the single source
# of truth and what the unit tests bind. They are deliberately not repeated
# here: a copied .env would pin stale numbers over any later recalibration.
# Uncomment one only to override it for a deliberate experiment, and bump
# SCORING_VERSION alongside, or persisted analyses stop being explainable.
# These values are NOT an agreed product decision - see §27.5.
# SCORING_VERSION=
# SCORING_WATCHING_THRESHOLD=
# SCORING_CONSIDERING_THRESHOLD=
# SCORING_STRONG_THRESHOLD=
# SCORING_MIN_SPEC_COVERAGE=
# SCORING_SCORE_PRECISION=
