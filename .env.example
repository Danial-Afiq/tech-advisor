# Local PostgreSQL (safe development defaults)
POSTGRES_DB=techadvisor
POSTGRES_USER=techadvisor
POSTGRES_PASSWORD=devpassword
DB_HOST=localhost
DB_PORT=5433

# Future application secrets - leave real values out of Git
AI_API_KEY=
JWT_SECRET=

# Ingestion is opt-in until real adapters/sinks and admin authentication are integrated.
INGESTION_SCHEDULING_ENABLED=false
INGESTION_ANCHOR=2026-09-17T05:00:00Z
INGESTION_ENABLED_SOURCES=
