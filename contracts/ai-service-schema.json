{
  "Analysis": {
    "additionalProperties": false,
    "description": "Channel A's finished judgement (AGENTS.md \u00a77.1), computed in Java.\n\n`upgrade_score` is the single 0-1 aggregate the verdict tier was derived\nfrom, where 1.0 is a strong upgrade recommendation and 0.0 is not\nrecommended. It is context for the grader, not something to recompute or\noverrule: the model grades owner evidence and may disagree with the\nverdict, which is the point of keeping the two channels separate (\u00a77.2).",
    "properties": {
      "deciding_factors": {
        "default": [],
        "items": {
          "enum": [
            "battery",
            "camera",
            "performance",
            "display",
            "build_quality",
            "thermals",
            "software_support",
            "connectivity",
            "audio",
            "value",
            "longevity",
            "portability"
          ],
          "type": "string"
        },
        "title": "Deciding Factors",
        "type": "array"
      },
      "upgrade_score": {
        "maximum": 1.0,
        "minimum": 0.0,
        "title": "Upgrade Score",
        "type": "number"
      },
      "verdict": {
        "enum": [
          "NO_MEANINGFUL_CHANGE",
          "WORTH_WATCHING",
          "WORTH_CONSIDERING",
          "STRONG_UPGRADE_CANDIDATE"
        ],
        "title": "Verdict",
        "type": "string"
      }
    },
    "required": [
      "verdict",
      "upgrade_score"
    ],
    "title": "Analysis",
    "type": "object"
  },
